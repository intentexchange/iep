{
  "name": "@intentexchange/spec",
  "version": "0.2.0",
  "description": "Intent Exchange Protocol types, JSON Schemas, Ed25519, JCS, and session machine",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://intentexchange.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentexchange/iep.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/intentexchange/iep/issues"
  },
  "keywords": [
    "iep",
    "intent-exchange",
    "a2a",
    "agents",
    "protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": ["dist", "schemas", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
