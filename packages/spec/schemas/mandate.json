{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentexchange.dev/schemas/mandate.json",
  "title": "Mandate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principal_did",
    "agent_did",
    "grants",
    "ping_cap",
    "expires_at",
    "reveal",
    "limits",
    "signature"
  ],
  "properties": {
    "principal_did": { "type": "string", "minLength": 1 },
    "agent_did": { "type": "string", "minLength": 1 },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["publish", "query", "ping", "accept", "reject", "reveal", "propose", "ratify"]
      }
    },
    "ping_cap": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "string", "format": "date-time" },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price"],
      "properties": {
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price"],
      "properties": {
        "price": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "max_rounds": { "type": "integer", "minimum": 1 },
    "tolerance": { "type": "number", "minimum": 0 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
